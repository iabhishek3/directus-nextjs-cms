    "buttons": {
      "gap": 16,
      "marginTop": 40,
      "primary": {
        "text": "Start Building",
        "href": "#",
        "showArrow": true,
        "fontSize": 16,
        "fontWeight": 600,
        "padding": "14px 32px",
