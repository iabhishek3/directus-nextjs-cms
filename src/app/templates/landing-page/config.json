        "span": 1,
        "stats": [
          {
            "value": "92%",
            "label": "CPU"
          },
          {
            "value": "87%",
            "label": "Memory"
          },
          {
            "value": "67%",
            "label": "Network"
          },
          {
            "value": "90%",
            "label": "Storage"
          }
