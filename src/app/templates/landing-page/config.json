  "features": {
    "padding": "100px 32px",
    "title": "Everything you need to ship",
    "titleSize": 40,
    "titleWeight": 800,
    "titleLetterSpacing": "-0.03em",
    "subtitle": "Built for modern teams. Powerful features that help you build, deploy, and scale faster than ever.",
