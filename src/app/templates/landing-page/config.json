        "title": "Command Palette",
        "description": "Navigate anywhere instantly with powerful keyboard shortcuts.",
        "icon": "command",
        "span": 1,
        "shortcut": [
          "Cmd",
          "K"
        ]
      },
      {
        "id": "analytics",
        "title": "Analytics",
        "description": "Deep insights into your application performance.",
        "icon": "bar-chart",
        "span": 1,
        "showChart": true
      },
      {
        "id": "speed",
        "title": "Blazing Fast",
        "description": "Edge-optimized infrastructure for sub-50ms response times globally.",
        "icon": "zap",
        "span": 1,
        "highlight": "~32ms",
        "highlightLabel": "avg response"
      },
      {
        "id": "security",
        "title": "Enterprise Security",
        "description": "SOC2 compliant with end-to-end encryption and SSO support.",
        "icon": "shield",
        "span": 1,
        "badges": [
          "SOC2",
          "GDPR",
          "HIPAA"
        ]
      }
    ],
    "cardBorderRadius": 16,
    "cardPadding": "32px"
  },
